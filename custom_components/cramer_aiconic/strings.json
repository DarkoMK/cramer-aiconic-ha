      "init": {
        "title": "Cramer AiConic options",
        "data": {
          "scan_interval": "Polling interval",
          "enable_settings": "Read mower settings"
        },
        "data_description": {
          "scan_interval": "The mower pushes a status update roughly every 30 seconds, so polling faster than that gains little.",
          "enable_settings": "Reads the light, sound, obstacle and site settings the cloud does not cache. This briefly opens the same connection the phone app uses, so the app may reconnect while it happens. Turn off if that is a nuisance."
        }
      }
    }
